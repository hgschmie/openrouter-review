{
  "name": "openrouter-review",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A small GitHub Action for configurable OpenRouter code reviews",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-dist": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts eslint.config.mjs",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run check-dist",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "minimatch": "11.0.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
